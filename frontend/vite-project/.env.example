# Backend API base URL
VITE_API_URL=http://localhost:5000/api/v1

# Canonical site origin used to generate public/sitemap.xml.
# Set this to the production domain, e.g. https://www.holytrinity.example
# If unset, "npm run build" skips sitemap generation.
VITE_SITE_URL=

# Note: The Stripe publishable key is NOT set here.
# It is returned securely by the backend (STRIPE_PUBLISHABLE_KEY)
# in the /donations/payment-intent response and passed to Stripe Elements.
