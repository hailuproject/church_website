# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/church_cms

# JWT
JWT_SECRET=change_this_access_secret_64_chars_minimum_please
JWT_REFRESH_SECRET=change_this_refresh_secret_64_chars_minimum_please
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d
REFRESH_TOKEN_COOKIE_NAME=church_refresh_token
ACCESS_TOKEN_COOKIE_NAME=church_access_token

# Client
CLIENT_URL=http://localhost:5173

# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM='Church CMS <your_email@gmail.com>'

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# App
API_PREFIX=/api/v1
MAX_UPLOAD_IMAGE_MB=5
MAX_UPLOAD_AUDIO_MB=25
MAX_UPLOAD_VIDEO_MB=100
MAX_UPLOAD_PDF_MB=20
